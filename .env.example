NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-server-only-never-public
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_FACEBOOK_AUTH_ENABLED=false
NIVO_ENVIRONMENT=production
NIVO_CONSULTATION_ENABLED=false
NIVO_AUDIO_ENABLED=false
NIVO_RETENTION_JOB_READY=false
NIVO_OPERATIONAL_METRICS=false

# Optional Web Push. Leave disabled until Edge Function + Vault/Cron have been verified.
# Public key may be returned to the browser. Private key stays server-only.
NIVO_PUSH_READY=false
NIVO_VAPID_PUBLIC_KEY=
NIVO_VAPID_PRIVATE_KEY=
NIVO_VAPID_SUBJECT=mailto:admin@your-domain.example
# Set this secret on the Supabase Edge Function and in Vault; never NEXT_PUBLIC_*.
NIVO_PUSH_CRON_SECRET=
