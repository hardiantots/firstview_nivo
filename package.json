{
  "name": "nivo-nextjs-app",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "node --test scripts/sdd-api.test.cjs scripts/sdd34.test.cjs scripts/sdd57.test.cjs scripts/sdd-production.test.cjs scripts/sdd-analytics.test.cjs scripts/sdd-craving.test.cjs scripts/sdd-push.test.cjs scripts/sdd-buddy.test.cjs scripts/code-quality.test.cjs scripts/auth-session.test.cjs scripts/onboarding.test.cjs",
    "supabase:check": "node --env-file=.env.local scripts/supabase-readiness.cjs",
    "check": "npm run format:check && npm run type-check && npm run lint && npm test && npm run build",
    "env:check": "node scripts/check-env.js",
    "predeploy": "npm run check",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod",
    "format:features": "prettier --write \"src/features/{buddy,craving,journey,log,reminders,contact-professional,profile-settings}/**/*.{ts,tsx}\" \"src/shared/{api,journey}/**/*.ts\" \"src/app/api/journey/route.ts\" \"scripts/code-quality.test.cjs\" \"src/shared/lib/{auth,errors}.ts\" \"src/shared/lib/db/journey.ts\" \"src/features/tracker/TrackerPage/{CravingHistoryDetailPage,CravingHistoryListPage,craving-history}.{ts,tsx}\" \"src/features/home/**/*.{ts,tsx}\" \"src/features/charts/{bars,ring,trend-area}.tsx\" \"src/components/ui/{nivo,progress-ring,page-navigation,responsive-sections}.tsx\" \"src/shared/auth/**/*.ts*\" \"src/shared/lib/{auth-storage,supabase}.ts\" \"src/app/{providers,page}.tsx\" \"src/app/{signin,signup,welcome,auth/callback}/page.tsx\" \"scripts/auth-session.test.cjs\" \"src/shared/hooks/use-compact-layout.ts\" \"src/features/{support,notifications}/**/*.{ts,tsx}\" \"src/features/pricing/PricingPage/PricingPage.tsx\" \"src/features/onboarding/{JourneySetupScreen,SetupFrame}.tsx\" \"src/features/auth/SignInPage/SignUpScreen.tsx\" \"src/app/{onboarding,motivation}/page.tsx\" \"src/app/api/onboarding/route.ts\" \"scripts/onboarding.test.cjs\"",
    "format:check": "prettier --check \"src/features/{buddy,craving,journey,log,reminders,contact-professional,profile-settings}/**/*.{ts,tsx}\" \"src/shared/{api,journey}/**/*.ts\" \"src/app/api/journey/route.ts\" \"scripts/code-quality.test.cjs\" \"src/shared/lib/{auth,errors}.ts\" \"src/shared/lib/db/journey.ts\" \"src/features/tracker/TrackerPage/{CravingHistoryDetailPage,CravingHistoryListPage,craving-history}.{ts,tsx}\" \"src/features/home/**/*.{ts,tsx}\" \"src/features/charts/{bars,ring,trend-area}.tsx\" \"src/components/ui/{nivo,progress-ring,page-navigation,responsive-sections}.tsx\" \"src/shared/auth/**/*.ts*\" \"src/shared/lib/{auth-storage,supabase}.ts\" \"src/app/{providers,page}.tsx\" \"src/app/{signin,signup,welcome,auth/callback}/page.tsx\" \"scripts/auth-session.test.cjs\" \"src/shared/hooks/use-compact-layout.ts\" \"src/features/{support,notifications}/**/*.{ts,tsx}\" \"src/features/pricing/PricingPage/PricingPage.tsx\" \"src/features/onboarding/{JourneySetupScreen,SetupFrame}.tsx\" \"src/features/auth/SignInPage/SignUpScreen.tsx\" \"src/app/{onboarding,motivation}/page.tsx\" \"src/app/api/onboarding/route.ts\" \"scripts/onboarding.test.cjs\"",
    "test:ui:home": "node scripts/home-dashboard-browser.cjs",
    "test:ui:auth": "node scripts/auth-session-browser.cjs",
    "test:ui:sections": "node scripts/responsive-sections-browser.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
