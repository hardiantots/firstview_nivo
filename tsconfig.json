{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/lib/*": [
        "./src/shared/lib/*"
      ],
      "@/hooks/*": [
        "./src/shared/hooks/*"
      ],
      "@/data/*": [
        "./src/shared/data/*"
      ],
      "@/assets/*": [
        "./src/shared/assets/*"
      ]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "target": "ES2017"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "SDD-Script/evidence/source-before",
    "supabase/functions"
  ]
}
